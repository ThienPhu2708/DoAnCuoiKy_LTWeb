@model DoAn_LTWeb.ViewModels.ProductCreateViewModel
@{
    ViewBag.Title = "Chỉnh sửa sản phẩm";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<h1 class="text-3xl font-bold text-gray-800 mb-6 border-b border-gray-300 pb-3">
    @ViewBag.Title: <span class="text-gray-600 font-medium">@Model.SanPham.TENSP</span>
</h1>
@if (TempData["ThongBao"] != null)
{
    <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded relative mb-6 flex items-center shadow-sm" role="alert">
        <i class="fas fa-check-circle mr-2 text-xl"></i>
        <span class="block sm:inline font-medium">@TempData["ThongBao"]</span>

        <span class="absolute top-0 bottom-0 right-0 px-4 py-3" onclick="this.parentElement.style.display='none';">
            <i class="fas fa-times text-green-500 cursor-pointer hover:text-green-800"></i>
        </span>
    </div>
}
<section id="edit-product-section">
    @using (Html.BeginForm("EditProduct", "Admin", FormMethod.Post, new { @class = "space-y-6", enctype = "multipart/form-data" }))
    {
        @Html.AntiForgeryToken()

        @Html.HiddenFor(model => model.SanPham.MASP)

        @Html.HiddenFor(model => model.BienThe.MABIENTHE)
        @Html.HiddenFor(model => model.SanPham.ANHBIA)
        <div class="bg-white p-6 rounded-xl shadow-lg">

            @Html.ValidationSummary(true, "", new { @class = "text-red-600 bg-red-50 p-3 rounded-lg text-sm mb-4" })


            <!-- Hàng 1: Tên sản phẩm -->
            <div>
                @Html.LabelFor(model => model.SanPham.TENSP, "Tên Sản phẩm", new { @class = "block text-sm font-medium text-gray-700 mb-1" })
                @Html.EditorFor(model => model.SanPham.TENSP, new { htmlAttributes = new { @class = "w-full p-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-400" } })
                @Html.ValidationMessageFor(model => model.SanPham.TENSP, "", new { @class = "text-red-600 text-xs mt-1" })
            </div>

            <!-- Hàng 2: Loại SP và Thương hiệu (chia 2 cột) -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mt-6">
                <div>
                    @Html.LabelFor(model => model.SanPham.MALOAI, "Loại sản phẩm", new { @class = "block text-sm font-medium text-gray-700 mb-1" })
                    @Html.DropDownListFor(model => model.SanPham.MALOAI, (IEnumerable<SelectListItem>)ViewBag.MALOAI, "--- Chọn loại sản phẩm ---", new { @class = "w-full p-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-400" })
                    @Html.ValidationMessageFor(model => model.SanPham.MALOAI, "", new { @class = "text-red-600 text-xs mt-1" })
                </div>
                <div>
                    @Html.LabelFor(model => model.SanPham.MATHUONGHIEU, "Thương hiệu", new { @class = "block text-sm font-medium text-gray-700 mb-1" })

                    @Html.DropDownListFor(model => model.SanPham.MATHUONGHIEU, (IEnumerable<SelectListItem>)ViewBag.MATHUONGHIEU, "--- Chọn thương hiệu ---", new { @class = "w-full p-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-400" })
                    @Html.ValidationMessageFor(model => model.SanPham.MATHUONGHIEU, "", new { @class = "text-red-600 text-xs mt-1" })
                </div>
            </div>


            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    @Html.LabelFor(model => model.BienThe.TENBIENTHE, "Tên Biến thể (Vd: Màu Đen)", new { @class = "block text-sm font-medium text-gray-700 mb-1" })
                    @Html.EditorFor(model => model.BienThe.TENBIENTHE, new { htmlAttributes = new { @class = "w-full p-2 border" } })
                    @Html.ValidationMessageFor(model => model.BienThe.TENBIENTHE, "", new { @class = "text-red-600 text-xs mt-1" })
                </div>
                <div>
                    @Html.LabelFor(model => model.BienThe.SOLUONGTON, "Số lượng tồn", new { @class = "block text-sm font-medium text-gray-700 mb-1" })
                    @Html.EditorFor(model => model.BienThe.SOLUONGTON, new { htmlAttributes = new { @class = "w-full p-2 border", type = "number", min = "0" } })
                    @Html.ValidationMessageFor(model => model.BienThe.SOLUONGTON, "", new { @class = "text-red-600 text-xs mt-1" })
                </div>
            </div>


            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mt-6">
                <div>
                    @Html.LabelFor(model => model.BienThe.GIAGOC, "Giá Gốc (VNĐ)", new { @class = "block text-sm font-medium text-gray-700 mb-1" })
                    @Html.EditorFor(model => model.BienThe.GIAGOC, new { htmlAttributes = new { @class = "w-full p-2 border ...", type = "number", min = "0" } })
                    @Html.ValidationMessageFor(model => model.BienThe.GIAGOC, "", new { @class = "block text-sm font-medium text-gray-700 mb-1" })
                </div>
                <div>
                    @Html.LabelFor(model => model.BienThe.GIABAN, "Giá Bán (VNĐ)", new { @class = "block text-sm font-medium text-gray-700 mb-1" })
                    @Html.EditorFor(model => model.BienThe.GIABAN, new { htmlAttributes = new { @class = "w-full p-2 border ...", type = "number", min = "0" } })
                    @Html.ValidationMessageFor(model => model.BienThe.GIABAN, "", new { @class = "block text-sm font-medium text-gray-700 mb-1" })
                </div>
            </div>

            <!-- Hàng 3: Mô tả -->
            <div class="mt-6">
                @Html.LabelFor(model => model.SanPham.MOTA, "Mô tả", new { @class = "block text-sm font-medium text-gray-700 mb-1" })
                @Html.TextAreaFor(model => model.SanPham.MOTA, new { @class = "w-full p-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-400", rows = 10, @id = "txtMoTa" })
                @Html.ValidationMessageFor(model => model.SanPham.MOTA, "", new { @class = "text-red-600 text-xs mt-1" })
            </div>

            <!-- Hàng 4: Đánh giá -->
            <div class="mt-6">
                @Html.LabelFor(model => model.SanPham.DANHGIA, "Đánh giá (0-5)", new { @class = "block text-sm font-medium text-gray-700 mb-1" })
                @Html.EditorFor(model => model.SanPham.DANHGIA, new { htmlAttributes = new { @class = "w-full p-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-400", type = "number", step = "0.1", min = "0", max = "5" } })
                @Html.ValidationMessageFor(model => model.SanPham.DANHGIA, "", new { @class = "text-red-600 text-xs mt-1" })
            </div>

            <!-- Hàng 5: Ảnh bìa  -->
            <div class="mt-6">
                @Html.Label("currentImage", "Ảnh bìa hiện tại", new { @class = "block text-sm font-medium text-gray-700 mb-1" })
                @if (!string.IsNullOrEmpty(Model.SanPham.ANHBIA))
                {
                    <img src="@Url.Content("~/Content/Assets/Product_Images/" + Model.SanPham.ANHBIA)" alt="@Model.SanPham.TENSP" class="h-32 w-32 object-cover rounded-lg shadow mb-4" onerror="this.src='https://placehold.co/128x128/E2E8F0/A0AEC0?text=Error'; this.onerror=null;" />
                }
                else
                {
                    <span class="text-gray-500 text-sm italic">Chưa có ảnh bìa.</span>
                }
                @Html.Label("fileUpload", "Tải lên ảnh mới (Để thay thế ảnh cũ)", new { @class = "block text-sm font-medium text-gray-700 mb-1 mt-4" })
                <input type="file" name="fileUpload" id="fileUpload" class="block w-full text-sm text-gray-500
                    file:mr-4 file:py-2 file:px-4
                    file:rounded-lg file:border-0
                    file:text-sm file:font-semibold
                    file:bg-blue-50 file:text-blue-700
                    hover:file:bg-blue-100" />
            </div>

            <div class="mt-6">
                @Html.LabelFor(model => model.GalleryFiles, "Tải lên ảnh Gallery MỚI", new { @class = "block text-sm font-medium text-gray-700 mb-1 mt-4" })

                <input type="file" name="GalleryFiles" id="GalleryFiles" multiple
                       class="block w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-semibold file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100"
                       onchange="previewGallery(this)" />

                <div id="gallery-preview" class="flex flex-wrap gap-2 mt-4"></div>
            </div>
            <div class="bg-gray-50 p-6 rounded-xl border border-gray-200 mt-8 mb-6">
                <h3 class="text-lg font-bold text-gray-800 mb-4">Thông số kỹ thuật</h3>

                <table class="min-w-full border bg-white" id="tblThongSo">
                    <thead class="bg-gray-100">
                        <tr>
                            <th class="px-4 py-2 border text-left text-sm">Nhóm</th>
                            <th class="px-4 py-2 border text-left text-sm">Tên thông số</th>
                            <th class="px-4 py-2 border text-left text-sm">Giá trị</th>
                            <th class="px-4 py-2 border text-center w-16">Xóa</th>
                        </tr>
                    </thead>
                    <tbody id="tbodyThongSo">
                        @if (ViewBag.ListThongSo != null)
                        {
                            foreach (var item in ViewBag.ListThongSo as List<DoAn_LTWeb.Models.THONGSO_KYTHUAT>)
                            {
                                <tr>
                                    <td class="p-2 border">
                                        <input type="text" name="TS_Nhom[]" value="@item.NHOM_THONGSO" class="w-full p-1 border rounded" />
                                    </td>
                                    <td class="p-2 border">
                                        <input type="text" name="TS_Ten[]" value="@item.TEN_THONGSO" class="w-full p-1 border rounded" required />
                                    </td>
                                    <td class="p-2 border">
                                        <input type="text" name="TS_Giatri[]" value="@item.GIATRI" class="w-full p-1 border rounded" required />
                                    </td>
                                    <td class="p-2 border text-center">
                                        <button type="button" class="text-red-500" onclick="xoaDong(this)"><i class="fas fa-trash"></i></button>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>

                <div class="mt-4 flex gap-2">
                    <button type="button" onclick="themDongMoi()" class="px-4 py-2 bg-green-600 text-white text-sm font-bold rounded hover:bg-green-700">
                        + Thêm dòng thông số
                    </button>
                </div>
            </div>

            <div class="flex items-center justify-end space-x-4 pt-5 border-t border-gray-200 mt-6">
                @Html.ActionLink("Quay lại", "Products", "Admin", null, new { @class = "px-4 py-2 bg-gray-200 text-gray-700 font-semibold rounded-lg hover:bg-gray-300 transition" })
                <button type="submit" class="px-4 py-2 bg-blue-600 text-white font-semibold rounded-lg...">
                    <i class="fas fa-save mr-2"></i> Lưu thay đổi
                </button>
            </div>
        </div>
    }
</section>

@section Scripts {
    <script src="https://cdn.ckeditor.com/4.22.1/standard/ckeditor.js"></script>

    <script>
        // 2. Kích hoạt CKEditor thay thế cho ô có id="txtMoTa"
        CKEDITOR.replace('txtMoTa', {
            height: 400,
            versionCheck: false,
            extraPlugins: 'uploadimage',

            // Cấu hình Upload ảnh (Kết nối với hàm ProcessUpload trong Controller)
            filebrowserUploadUrl: '/Admin/ProcessUpload',
            uploadUrl: '/Admin/ProcessUpload',

            // Bật nút Hình ảnh trên thanh công cụ
            toolbar: [
                { name: 'document', items: ['Source', '-', 'NewPage', 'Preview'] },
                { name: 'clipboard', items: ['Cut', 'Copy', 'Paste', '-', 'Undo', 'Redo'] },
                { name: 'basicstyles', items: ['Bold', 'Italic', 'Underline', 'Strike'] },
                { name: 'paragraph', items: ['NumberedList', 'BulletedList', '-', 'Outdent', 'Indent', '-', 'JustifyLeft', 'JustifyCenter', 'JustifyRight', 'JustifyBlock'] },
                { name: 'insert', items: ['Image', 'Table', 'HorizontalRule'] },
                { name: 'styles', items: ['Styles', 'Format', 'Font', 'FontSize'] },
                { name: 'colors', items: ['TextColor', 'BGColor'] },
                { name: 'tools', items: ['Maximize'] }
            ],
            removeDialogTabs: 'image:advanced;image:Link'
        });
    </script>
    <script>
        // Hàm xem trước ảnh Gallery
        function previewGallery(input) {
            var previewBox = document.getElementById('gallery-preview');
            previewBox.innerHTML = ''; // Xóa các ảnh cũ nếu chọn lại

            if (input.files) {
                var filesAmount = input.files.length;

                for (i = 0; i < filesAmount; i++) {
                    var reader = new FileReader();

                    reader.onload = function (event) {
                        // Tạo thẻ ảnh
                        var imgElement = document.createElement("img");
                        imgElement.setAttribute("src", event.target.result);
                        imgElement.classList.add("h-20", "w-20", "object-cover", "rounded", "border", "border-gray-300", "shadow-sm");

                        // Đưa vào khung
                        previewBox.appendChild(imgElement);
                    }

                    reader.readAsDataURL(input.files[i]);
                }
            }
        }
    </script>
    <script>
        // Hàm thêm dòng mới vào bảng
        function themDongMoi() {
            var tbody = document.getElementById('tbodyThongSo');
            var tr = document.createElement('tr');

            tr.innerHTML = `
                            <td class="p-2 border">
                                <input type="text" name="TS_Nhom[]" placeholder="Nhóm..." class="w-full p-1 border rounded" />
                            </td>
                            <td class="p-2 border">
                                <input type="text" name="TS_Ten[]" placeholder="Tên..." class="w-full p-1 border rounded" required />
                            </td>
                            <td class="p-2 border">
                                <input type="text" name="TS_Giatri[]" placeholder="Giá trị..." class="w-full p-1 border rounded" required />
                            </td>
                            <td class="p-2 border text-center">
                                <button type="button" class="text-red-500" onclick="xoaDong(this)"><i class="fas fa-trash"></i></button>
                            </td>
                        `;
            tbody.appendChild(tr);
        }

        // Hàm xóa dòng
        function xoaDong(btn) {
            if (confirm('Xóa dòng này?')) {
                var row = btn.parentNode.parentNode;
                row.parentNode.removeChild(row);
            }
        }
    </script>
}