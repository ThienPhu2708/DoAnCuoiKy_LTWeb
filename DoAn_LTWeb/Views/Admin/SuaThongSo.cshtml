@model DoAn_LTWeb.Models.THONGSO_KYTHUAT

@{
    ViewBag.Title = "Sửa thông số kỹ thuật";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="max-w-lg mx-auto bg-white p-8 rounded-xl shadow-lg mt-10">
    <h2 class="text-2xl font-bold text-gray-800 mb-6 border-b pb-2">Sửa thông số</h2>

    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(m => m.ID)
        @Html.HiddenFor(m => m.MASP) <div class="space-y-4">
            <div>
                <label class="block text-sm font-bold text-gray-700 mb-1">Nhóm</label>
                @Html.EditorFor(m => m.NHOM_THONGSO, new { htmlAttributes = new { @class = "w-full p-2 border rounded focus:ring-2 focus:ring-blue-400" } })
            </div>

            <div>
                <label class="block text-sm font-bold text-gray-700 mb-1">Tên thông số</label>
                @Html.EditorFor(m => m.TEN_THONGSO, new { htmlAttributes = new { @class = "w-full p-2 border rounded focus:ring-2 focus:ring-blue-400" } })
            </div>

            <div>
                <label class="block text-sm font-bold text-gray-700 mb-1">Giá trị</label>
                @Html.EditorFor(m => m.GIATRI, new { htmlAttributes = new { @class = "w-full p-2 border rounded focus:ring-2 focus:ring-blue-400" } })
            </div>

            <div class="flex justify-end gap-3 pt-4">
                <a href="@Url.Action("EditProduct", "Admin", new { id = Model.MASP })" class="px-4 py-2 bg-gray-200 text-gray-700 rounded hover:bg-gray-300">Hủy</a>

                <button type="submit" class="px-4 py-2 bg-blue-600 text-white font-bold rounded hover:bg-blue-700">
                    Lưu thay đổi
                </button>
            </div>
        </div>
    }
</div>